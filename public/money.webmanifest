{
  "id": "/money",
  "name": "MoneyFlow — Cash In & Out Manager",
  "short_name": "MoneyFlow",
  "description": "Track cash in and cash out — running balance, payment methods, search and history.",
  "start_url": "/money",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#1e3a8a",
  "background_color": "#f3f6fb",
  "share_target": {
    "action": "/money/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "images", "accept": ["image/jpeg", "image/png", "image/webp", "image/*"] }
      ]
    }
  },
  "icons": [
    { "src": "/money-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/money-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/money-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/money-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
