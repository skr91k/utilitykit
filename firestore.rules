rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has email (not anonymous)
    function hasEmail() {
      return request.auth.token.email != null;
    }

    // Helper function to check if user is the support admin
    // IMPORTANT: Replace 'SUPPORT_ADMIN_UID' with your actual support account UID
    function isSupportAdmin() {
      return request.auth.uid == 'vka12e2umlZS89BObKGl5hpthej2';
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Read-only admin console (/admin). Keep this list in sync with
    // ADMIN_EMAILS in src/utils/adminFirestore.ts. Verified Google sign-in only —
    // an unverified or anonymous token has no email_verified claim and fails here.
    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email in [
               'emst.shakir@gmail.com',
               'shakir.kadakkadan@gmail.com'
             ];
    }

    // ========================================
    // CHAT RULES
    // ========================================

    // Chat Rooms Collection
    match /chatRooms/{chatRoomId} {
      // Users can read their own chat room, support can read all
      allow read: if isAuthenticated() && hasEmail() &&
                    (isOwner(chatRoomId) || isSupportAdmin());

      // Users can create their own chat room
      allow create: if isAuthenticated() && hasEmail() && isOwner(chatRoomId);

      // Users can update their own chat room (for lastMessage updates)
      // Support can also update any room
      allow update: if isAuthenticated() && hasEmail() &&
                      (isOwner(chatRoomId) || isSupportAdmin());

      // Only support admin can delete chat rooms
      allow delete: if isSupportAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        // Users can read messages in their own chat room
        // Support can read all messages
        allow read: if isAuthenticated() && hasEmail() &&
                      (isOwner(chatRoomId) || isSupportAdmin());

        // Users can create messages in their own chat room
        // Support can create messages in any chat room (to reply)
        allow create: if isAuthenticated() && hasEmail() &&
                        (isOwner(chatRoomId) || isSupportAdmin());

        // Allow updating message (for read status)
        allow update: if isAuthenticated() && hasEmail() &&
                        (isOwner(chatRoomId) || isSupportAdmin()) &&
                        // Only allow updating the 'read' field
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        // Only support admin can delete messages
        allow delete: if isSupportAdmin();
      }
    }

    // ========================================
    // USER DATA RULES (Counter/Tasks)
    // ========================================

    // Users collection - each user can only access their own data
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);

      // Counter tasks collection
      match /counterTasks/{taskId} {
        allow read, write: if isAuthenticated() && isOwner(userId);

        // Task progress subcollection
        match /progress/{date} {
          allow read, write: if isAuthenticated() && isOwner(userId);
        }
      }

      // Default counter collection (for Quick Count task)
      match /defaultCounter/{docId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      // Private pastes - only the signed-in Google account that owns them
      match /pastes/{pasteId} {
        allow read, write: if isAuthenticated() && hasEmail() && isOwner(userId);
      }

      // Fuel & trip log - only the signed-in Google account that owns it
      match /fuelTrips/{tripId} {
        allow read, write: if isAuthenticated() && hasEmail() && isOwner(userId);
      }

      // MoneyFlow cash in/out ledger - only the signed-in Google account that owns it
      match /moneyTransactions/{txnId} {
        allow read, write: if isAuthenticated() && hasEmail() && isOwner(userId);
      }
    }

    // ========================================
    // PRESENCE TRACKING
    // ========================================

    // Presence collection - support can write, authenticated users can read
    match /presence/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSupportAdmin();
    }

    // ========================================
    // SPLIT EXPENSE - Public read/write, no login required
    // ========================================

    match /splitBooks/{bookId} {
      allow read, write: if true;

      match /expenses/{expenseId} {
        allow read, write: if true;
      }

      // Audit log: anyone can read and create, but cannot update or delete
      match /auditLog/{logId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // ========================================
    // CRICKET TRACKER - Public read/write via token (no login required)
    // Security is by obscurity of the random editToken / viewToken
    // ========================================

    match /cricketSeries/{editToken} {
      allow read, write: if true;

      match /matches/{matchId} {
        allow read, write: if true;

        match /innings/{inningsId} {
          allow read, write: if true;

          match /deliveries/{deliveryId} {
            allow read, write: if true;
          }
        }
      }

      // Log: anyone can read and create, but cannot modify or delete
      match /log/{logId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // View-only token lookup index
    match /cricketViewIndex/{viewToken} {
      allow read, write: if true;
    }

    // ========================================
    // PASTE BIN - Public board, no login required
    // Private pastes live under /users/{uid}/pastes
    // ========================================

    match /publicPastes/{pasteId} {
      allow read, delete: if true;
      // Guard against oversized writes; Firestore itself caps a document at 1 MiB
      allow create, update: if request.resource.data.content.size() <= 1000000 &&
                              request.resource.data.title.size() <= 200;
    }

    // Read-only copies of private pastes, published by their owner.
    // Anyone holding the unguessable token can read; only the owner can
    // create, refresh or revoke one.
    match /sharedPastes/{shareToken} {
      // 'get' only: you must already know the token. 'list' stays denied so the
      // collection cannot be enumerated, which is what keeps the token secret.
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() && hasEmail() &&
                      isOwner(request.resource.data.ownerUid) &&
                      request.resource.data.content.size() <= 1000000 &&
                      request.resource.data.title.size() <= 200;
      allow update: if isAuthenticated() && hasEmail() &&
                      isOwner(resource.data.ownerUid) &&
                      request.resource.data.ownerUid == resource.data.ownerUid &&
                      request.resource.data.content.size() <= 1000000 &&
                      request.resource.data.title.size() <= 200;
      allow delete: if isAuthenticated() && hasEmail() && isOwner(resource.data.ownerUid);
    }

    // Deny all other access by default.
    // The one exception is the admin console: rules are OR'd across matching
    // blocks, so this recursive read lets the two admin accounts see every
    // document in every collection — including any added later — while write
    // stays denied here for everyone, admins included.
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
